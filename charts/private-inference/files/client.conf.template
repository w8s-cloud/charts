# The client side, in each cluster that uses the model: an in-cluster
# endpoint that speaks both Ollama's API (/api/...) and the
# OpenAI-compatible one (/v1/...), adding the shared key and forwarding
# to the GPU cluster's gateway through w8s. Apps here call it by name and
# never hold the key. Also serves the chat page at /.
server {
  listen 8080;
  server_tokens off;
  client_max_body_size 64m;
  add_header X-Served-By-Cluster "__CLUSTER__" always;

  location = / {
    root /usr/share/nginx/html;
    try_files /index.html =404;
  }

  location = /healthz {
    return 200 "ok\n";
  }

  location = /w8s/site {
    default_type application/json;
    return 200 '{"cluster":"__CLUSTER__","gpu_cluster":"__GPU_CLUSTER__","default_model":"__MODEL__","endpoint":"__ENDPOINT__"}';
  }

  location ~ ^/(api|v1)/ {
    proxy_set_header Authorization "Bearer __KEY__";
    proxy_set_header Host __UPSTREAM_HOST__;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_pass http://__UPSTREAM__;
  }

  location / {
    return 404;
  }
}
